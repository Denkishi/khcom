+// khcom: a window's two edges, as the game sets them for 240 columns, on the
+// wider picture. One that reaches an edge of the game's screen reaches the
+// edge of the picture.
+static void _wideWindow(struct WindowN* win, uint16_t value) {
+	int end = value & 0xFF;
+	int start = value >> 8;
+	if (start > GBA_VIDEO_GAME_PIXELS && start > end) {
+		start = 0;
+	}
+	if (end > GBA_VIDEO_GAME_PIXELS) {
+		end = GBA_VIDEO_GAME_PIXELS;
+		if (start > GBA_VIDEO_GAME_PIXELS) {
+			start = GBA_VIDEO_GAME_PIXELS;
+		}
+	}
+	win->h.start = start == 0 ? 0 : start + KHCOM_WIDE;
+	win->h.end = end >= GBA_VIDEO_GAME_PIXELS ? GBA_VIDEO_HORIZONTAL_PIXELS : end == 0 ? 0 : end + KHCOM_WIDE;
+}
